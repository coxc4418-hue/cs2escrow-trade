rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'levayjorge@gmail.com' ||
        request.auth.token.email == 'jhinnoriega567@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Perfiles de usuarios reales (inician en balanceUsdc = 0, sin saldo ficticio)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.balanceUsdc == 0
        && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.balanceUsdc == resource.data.balanceUsdc
        && request.resource.data.role == resource.data.role
        && (resource.data.referredByCode == null || request.resource.data.referredByCode == resource.data.referredByCode)
      );
      allow delete: if false;
    }

    // Mapa público de códigos de referido -> uid del dueño (para atribución vitalicia ?ref=CODIGO)
    match /referral_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/referral_codes/$(code));
      allow update, delete: if false;
    }

    // Registros de referidos reales vinculados de por vida
    match /referrals/{referredUid} {
      allow read: if isSignedIn() && (
        resource.data.referrerUid == request.auth.uid ||
        referredUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && referredUid == request.auth.uid
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.earnedUsdc == 0
        && request.resource.data.volumeUsdc == 0
        && request.resource.data.tradesCount == 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Publicaciones reales de skins de usuarios
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.priceUsdc > 0;
      allow update, delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid || isAdmin()
      );
    }

    // Órdenes reales de Escrow
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'CREATED';
      allow update: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }
  }
}
